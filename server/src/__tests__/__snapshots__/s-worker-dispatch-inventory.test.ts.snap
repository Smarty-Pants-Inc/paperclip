exports[`S audited worker dispatch inventory > calls the same persisted FOR SHARE fence at manager.call and direct duplex 1`] = `"async function assertLeaseStartable(db: Db, companyId: string, providerLeaseId: string) { const tips = await db.select({ status: environmentLeases.status, metadata: environmentLeases.metadata }) .from(environmentLeases).where(and(eq(environmentLeases.companyId, companyId), eq(environmentLeases.providerLeaseId, providerLeaseId), sql\`not (coalesce(\${environmentLeases.metadata}, '{}'::jsonb) ? 'reusableLeaseSuccessor')\`)).for("share"); if (tips.some(tip => tip.status === "expired" || Object.hasOwn(tip.metadata ?? {}, "reusableSandboxLeaseSuperseded"))) { throw new SandboxLeaseStartDeniedError(); } }"`;

exports[`S audited worker dispatch inventory > calls the same persisted FOR SHARE fence at manager.call and direct duplex 2`] = `"async openDuplexChannel(input) { // Plugin-backed sandbox providers only: open the host-owned duplex route on // the plugin worker. The lease scope mirrors the sandbox execute path — the // provider driver key, the company, the environment, and the provider lease // id — so the route binds to the same worker session the runner streams. if (!input.lease.metadata?.sandboxProviderPlugin || !pluginWorkerManager) { throw new Error("Sandbox driver does not support duplex channels for this lease."); } const pluginId = readString(input.lease.metadata?.pluginId); const providerKey = readString(input.lease.metadata?.provider); const providerLeaseId = readString(input.lease.providerLeaseId); if (!pluginId || !providerKey || !providerLeaseId) { throw new Error( "Sandbox duplex channel needs a plugin id, a provider key, and a provider lease id on the lease.", ); } await assertLeaseStartable(db, input.lease.companyId, providerLeaseId); const worker = pluginWorkerManager.getWorker(pluginId); if (!worker) { throw new Error(\`Plugin worker "\${pluginId}" is not running for the duplex channel.\`); } const managerInput: WorkerManagerDuplexChannelOpenInput = { driverKey: providerKey, companyId: input.lease.companyId, environmentId: input.environment.id, providerLeaseId, command: input.command, }; const session = await worker.openDuplexChannel(managerInput); return adaptDuplexChannelHostSession(session); },"`;

exports[`S audited worker dispatch inventory > calls the same persisted FOR SHARE fence at manager.call and direct duplex 3`] = `"const workers = options.pluginWorkerManager; if (workers) options = { ...options, pluginWorkerManager: { ...workers, call: async (pluginId, method, params, ...args) => { const scope = params as { companyId?: string; providerLeaseId?: string | null; lease?: { providerLeaseId?: string | null }; operation?: { kind?: string } }; const providerLeaseId = scope.providerLeaseId ?? scope.lease?.providerLeaseId; const starts = ["environmentAcquireLease", "environmentResumeLease", "environmentRunnerIngressEndpoint", "environmentRealizeWorkspace", "environmentExecute", "environmentSyncIn", "environmentSyncOut"].includes(method) || (method === "environmentTask" && !["status", "stop", "complete", "release", "credentials", "read_state", "read_file", "archive_state"].includes(scope.operation?.kind ?? "")); try { if (starts && scope.companyId && providerLeaseId) await assertLeaseStartable(db, scope.companyId, providerLeaseId); } catch (error) { args[2]?.(); // No RPC was sent: settle the caller's tracked worker slot. throw error; } return workers.call(pluginId, method, params, ...args); }, } };"`;

